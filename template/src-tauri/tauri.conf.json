{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "{{NOME_PRODUTO_ASCII}}",
  "version": "1.0.0",
  "identifier": "{{com.exemplo.materia}}",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "{{TITULO_COMPLETO}}",
        "width": 1380,
        "height": 920,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": false,
        "decorations": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Education",
    "copyright": "{{COPYRIGHT}}",
    "shortDescription": "{{DESCRICAO_CURTA}}",
    "longDescription": "{{DESCRICAO_LONGA}}",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"]
      }
    }
  }
}
